# Supabase — proyecto "empeno"
# La URL y la llave pública pueden exponerse en el cliente.
NEXT_PUBLIC_SUPABASE_URL=https://oyjgzvyfxvzphqzyrtsf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Rl7XWlGMRXpNg6W-q29VQw_FhDgEsbb

# SECRETO — solo en el servidor. Omite RLS. NUNCA lo expongas al navegador.
# Dashboard → Project Settings → API → "service_role" (secret)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Secreto para firmar la cookie de sesión. En producción es OBLIGATORIO: sin él
# la app queda bloqueada (fail-closed). Genera uno con: openssl rand -base64 36
AUTH_SECRET=tu_secreto_de_sesion_aqui

# URL pública de la app (para los QR y los enlaces de WhatsApp).
NEXT_PUBLIC_APP_URL=https://empeno.vercel.app

# WhatsApp — Green API (https://console.green-api.com). Sin esto, los envíos
# no salen (no rompen el flujo, pero no notifican). Cárgalas también en Vercel.
# GREEN_API_URL es el "apiUrl" de tu instancia (si se deja vacío usa https://api.green-api.com).
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=1101000000
GREEN_API_TOKEN=tu_api_token_instance

# Números destino de las notificaciones automáticas (formato 52 + 10 dígitos).
SUPERVISOR_TEL=          # respaldo si no hay WhatsApp de Dirección en /configuracion
MECANICO_TEL=           # recibe vehículos para avalúo
GPS_EQUIPO_TEL=         # instalador de GPS (citas)

# Secreto de los crons (/api/cron/*). OBLIGATORIO para que se ejecuten.
# Vercel Cron lo manda como header Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=tu_secreto_de_cron

# GEMINI (lectura de INE / documentos del vehículo con IA). Opcional.
GEMINI_API_KEY=tu_api_key_de_gemini

# Rastreo GPS en vivo de vehículos en modalidad "gps" (src/lib/gpsRastreo.ts).
# Pendiente: falta confirmar el proveedor que usa la sucursal — sin esto,
# la ubicación se sigue anotando a mano (ver campo "Ubicación del GPS").
GPS_TRACKING_URL=
GPS_TRACKING_API_KEY=
